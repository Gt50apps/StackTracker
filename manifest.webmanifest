{
  "id": "stack-tracker-app",
  "name": "Stack Tracker",
  "short_name": "Stack Tracker",
  "description": "Track the books you read and the audiobooks you listen to, on a 3D bookshelf.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
